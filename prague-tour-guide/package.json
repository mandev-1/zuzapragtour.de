{
  "name": "zuzapragtour-de",
  "brandName": "Zuzana Manova Prague Tours",
  "version": "1.0.0",
  "description": "Zuza Prague Tours - Professional Prague tour guide services with Zuzana Manova",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-journal.cjs && next dev",
    "start": "next dev",
    "prebuild": "node scripts/generate-thumbnails.cjs && node scripts/generate-responsive-images.cjs && node scripts/generate-journal.cjs",
    "build": "next build",
    "postbuild": "node scripts/ping-sitemaps.js",
    "gen:journal": "node scripts/generate-journal.cjs",
    "new:blog": "node scripts/new-blog-post.cjs",
    "thumbs": "node scripts/generate-thumbnails.cjs",
    "thumbs:force": "node scripts/generate-thumbnails.cjs --force",
    "images": "node scripts/generate-responsive-images.cjs",
    "images:force": "node scripts/generate-responsive-images.cjs --force"
  },
  "keywords": [
    "Prague tours",
    "Prague tour guide",
    "Prague sightseeing",
    "Prague travel",
    "Czech Republic tours",
    "private Prague tours",
    "Prague walking tours",
    "Zuzana Manova"
  ],
  "author": "Zuzana Manova",
  "license": "MIT",
  "dependencies": {
    "@netlify/blobs": "^11.1.7",
    "framer-motion": "^14.7.1",
    "next": "^16.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "homepage": "https://zuzapragtour.de",
  "repository": {
    "type": "git",
    "url": "https://github.com/mandev-1/zuzapragtour.de.git"
  }
}
