{
  "name": "prague-tour-guide",
  "version": "1.0.0",
  "description": "Zuza Prague Tours - Professional Prague tour guide services with Zuzana Manova",
  "private": true,
  "scripts": {
    "start": "NODE_OPTIONS=--openssl-legacy-provider react-scripts start",
    "prebuild": "node scripts/generate-sitemap.js && node scripts/generate-route-meta.cjs",
    "new:blog": "node scripts/new-blog-post.cjs",
    "build": "NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
    "postbuild": "node scripts/ping-sitemaps.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "keywords": [
    "Prague tours",
    "Prague tour guide",
    "Prague sightseeing",
    "Prague travel",
    "Czech Republic tours",
    "private Prague tours",
    "Prague walking tours",
    "Zuzana Manova"
  ],
  "author": "Zuzana Manova",
  "license": "MIT",
  "dependencies": {
    "framer-motion": "^11.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.4",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.9",
    "tailwindcss": "^3.4.19"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "homepage": "https://zuzapragtour.de",
  "repository": {
    "type": "git",
    "url": "https://github.com/mandev-1/zuzapragtour.de.git"
  }
}
