    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wann ist in Prag im Winter das beste Licht zum Fotografieren?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Im Dezember geht die Sonne gegen 8 Uhr auf und kurz vor 16 Uhr unter. Die blaue Stunde liegt etwa zwischen 16 und 16:45 Uhr. Für Aufnahmen ohne Menschen kommen Sie zwischen 8 und 9 Uhr auf die Karlsbrücke."
          }
        },
        {
          "@type": "Question",
          "name": "Darf man in der Strahov-Bibliothek fotografieren?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja, mit einer Fotoerlaubnis, die Sie an der Kasse kaufen. Die Säle sehen Sie mit dem normalen Ticket nur von der Tür aus. Hinein kommen Sie nur mit einer privaten Führung, die Sie Monate im Voraus anfragen."
          }
        },
        {
          "@type": "Question",
          "name": "Muss man in Prager Sternerestaurants lange im Voraus reservieren?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Für Abende im Advent ja, mehrere Wochen. Unter der Woche im Januar und Februar bekommen Sie leichter einen Tisch."
          }
        },
        {
          "@type": "Question",
          "name": "Lohnt sich Karlsbad als Tagesausflug im Winter?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja. Die Fahrt dauert mit Auto oder Fernbus rund zwei Stunden, die Kolonnaden liegen nah beieinander, und an kalten Tagen dampfen die Quellen."
          }
        },
        {
          "@type": "Question",
          "name": "Gibt es in Prag private Führungen auf Deutsch?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja. Ich führe privat und auf Deutsch und plane die Route nach Ihren Wünschen, auf Wunsch auch nach dem Licht für Ihre Fotos."
          }
        }
      ]
    }
  ]
